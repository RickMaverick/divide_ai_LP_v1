{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/lists/**",
              "components/money/**",
              "components/navigation/**",
              "components/split/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|error|warning|info)$/]",
        "message": "<Badge> tone must be one of 'success' | 'error' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BalanceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|paidCents|consumedCents|balanceCents|style|key|ref|className|style|children)$/]",
        "message": "<BalanceRow> doesn't accept that prop. Declared props: name, paidCents, consumedCents, balanceCents, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:error|success|info|warning)$/]",
        "message": "<Banner> tone must be one of 'error' | 'success' | 'info' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|onPress|disabled|loading|icon|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, onPress, disabled, loading, icon, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|destructive|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'destructive' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, elevation, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:none|sm|md)$/]",
        "message": "<Card> elevation must be one of 'none' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|right|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|onPress|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, selected, onPress, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ChipGroup> doesn't accept that prop. Declared props: label, options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChangeText|error|style|key|ref|className|style|children)$/]",
        "message": "<DateField> doesn't accept that prop. Declared props: label, value, onChangeText, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExpenseRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|payer|date|category|amountCents|hasReceipt|variant|onPress|style|key|ref|className|style|children)$/]",
        "message": "<ExpenseRow> doesn't accept that prop. Declared props: title, payer, date, category, amountCents, hasReceipt, variant, onPress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExpenseRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:card|plain)$/]",
        "message": "<ExpenseRow> variant must be one of 'card' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fab'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|collapsed|onPress|style|key|ref|className|style|children)$/]",
        "message": "<Fab> doesn't accept that prop. Declared props: label, icon, collapsed, onPress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|type|memberCount|balanceCents|onPress|style|key|ref|className|style|children)$/]",
        "message": "<GroupRow> doesn't accept that prop. Declared props: name, type, memberCount, balanceCents, onPress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChangeText|placeholder|error|multiline|inputMode|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, defaultValue, onChangeText, placeholder, error, multiline, inputMode, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|cents|onChangeCents|error|style|key|ref|className|style|children)$/]",
        "message": "<MoneyInput> doesn't accept that prop. Declared props: label, cents, onChangeCents, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute > JSXIdentifier[name!=/^(?:cents|kind|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<MoneyText> doesn't accept that prop. Declared props: cents, kind, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:balance|amount)$/]",
        "message": "<MoneyText> kind must be one of 'balance' | 'amount'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:positive|negative|neutral|none)$/]",
        "message": "<MoneyText> tone must be one of 'positive' | 'negative' | 'neutral' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|base|lg|xl|2xl)$/]",
        "message": "<MoneyText> size must be one of 'xs' | 'sm' | 'base' | 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|subtitle|actionLabel|onAction|onPress|style|key|ref|className|style|children)$/]",
        "message": "<PersonRow> doesn't accept that prop. Declared props: name, subtitle, actionLabel, onAction, onPress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|backLabel|onBack|style|key|ref|className|style|children)$/]",
        "message": "<ScreenHeader> doesn't accept that prop. Declared props: title, backLabel, onBack, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|height|style|key|ref|className|style|children)$/]",
        "message": "<SplitBar> doesn't accept that prop. Declared props: values, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitEditor'] > JSXAttribute > JSXIdentifier[name!=/^(?:totalCents|participants|defaultMode|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SplitEditor> doesn't accept that prop. Declared props: totalCents, participants, defaultMode, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitEditor'] > JSXAttribute[name.name='defaultMode'] > Literal[value!=/^(?:equal|amounts|percent)$/]",
        "message": "<SplitEditor> defaultMode must be one of 'equal' | 'amounts' | 'percent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaleNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|actionLabel|onRetry|style|key|ref|className|style|children)$/]",
        "message": "<StaleNotice> doesn't accept that prop. Declared props: message, actionLabel, onRetry, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|amountCents|onSettle|settled|style|key|ref|className|style|children)$/]",
        "message": "<SuggestionRow> doesn't accept that prop. Declared props: from, to, amountCents, onSettle, settled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|badges|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, badges, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:inicio|grupos|amigos|avisos|perfil)$/]",
        "message": "<TabBar> active must be one of 'inicio' | 'grupos' | 'amigos' | 'avisos' | 'perfil'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TotalsCards'] > JSXAttribute > JSXIdentifier[name!=/^(?:receivableCents|owedCents|showBalance|style|key|ref|className|style|children)$/]",
        "message": "<TotalsCards> doesn't accept that prop. Declared props: receivableCents, owedCents, showBalance, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
